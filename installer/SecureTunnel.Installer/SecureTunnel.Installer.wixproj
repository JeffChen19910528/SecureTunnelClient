<Project Sdk="WixToolset.Sdk/5.0.2">

  <!--
    Production MSI for SecureTunnel Connect (Agent service + WPF client).
    Inputs are the framework-dependent publish directories produced by
    deploy\package.ps1 (artifacts\<version>\Agent and \Connect), so run
    that script first. Build with: deploy\build-msi.ps1
  -->
  <PropertyGroup>
    <OutputName>SecureTunnelConnect-$(Version)-win-x64</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <PublishRoot Condition="'$(PublishRoot)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\$(Version)\</PublishRoot>
    <DefineConstants>$(DefineConstants);PublishRoot=$(PublishRoot);ProductVersion=$(Version)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>

</Project>
