<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Self-contained installer for SecureTunnel Connect. Needs nothing but the .NET SDK to build (no WiX or other
    installer toolchain) and nothing but Windows to run. deploy\build-setup.ps1 passes PayloadZip (the Agent and
    Connect folders) which is embedded into the single-file executable.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SecureTunnel.Setup</RootNamespace>
    <AssemblyName>SecureTunnelSetup</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(PayloadZip)' != '' And Exists('$(PayloadZip)')">
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="payload.zip" />
  </ItemGroup>

</Project>
