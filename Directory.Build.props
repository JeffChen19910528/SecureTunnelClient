<Project>

  <!-- Shared version for all projects; deploy/package.ps1 and deploy/build-setup.ps1 name their output after it. -->
  <PropertyGroup>
    <Version>0.7.0</Version>
    <InformationalVersion>0.7.0</InformationalVersion>
  </PropertyGroup>

  <!--
    Without this, the Roslyn compiler embeds the local, developer-machine
    absolute path to the .pdb file (e.g. "C:\Users\<name>\...\obj\...") in
    every compiled assembly's CodeView debug directory - a real finding
    from Phase C6 packaging (deploy/package.ps1's security check caught
    it). ContinuousIntegrationBuild activates Roslyn's deterministic
    /pathmap substitution so published binaries carry no developer-machine
    path. See docs/c6-packaging-report.md.
  -->
  <PropertyGroup>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <!--
      ContinuousIntegrationBuild alone only activates SourceLink's PathMap
      generation when a SourceLink package is referenced (none is, here).
      Set PathMap explicitly so the compiler substitutes the repo root in
      every embedded PDB path, regardless of SourceLink.
    -->
    <PathMap>$(MSBuildThisFileDirectory)=/build/</PathMap>
  </PropertyGroup>

</Project>
